# Web market-data service. Copy to .env for local/Docker deployment.
APP_ENV=development
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_USDM_REST_URL=https://fapi.binance.com
BINANCE_HTTP_TIMEOUT=10
PUBLIC_MAX_BARS=300

# Server-side AI credentials only. Never put these in frontend variables.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_THINKING=true
AI_REASONING_EFFORT=medium
