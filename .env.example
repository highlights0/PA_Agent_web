# Multi-exchange market-data configuration
APP_ENV=development
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Binance Global: Spot + USDⓈ-M Futures (availability depends on the network region)
# Binance public market-data-only host (works independently of the global trading API host)
BINANCE_SPOT_REST_URL=https://data-api.binance.vision
BINANCE_USDM_REST_URL=https://fapi.binance.com

# Alternative public Spot sources
BINANCE_US_SPOT_REST_URL=https://api.binance.us
COINBASE_SPOT_REST_URL=https://api.exchange.coinbase.com

BINANCE_HTTP_TIMEOUT=10
PUBLIC_MAX_BARS=300

# Server-side AI credentials only. Never put these in frontend variables.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_THINKING=true
AI_REASONING_EFFORT=medium

# Public analysis is disabled until an operator configures an AI key.
PUBLIC_ANALYSIS_ENABLED=false
PUBLIC_ANALYSIS_PER_IP_DAILY=5
PUBLIC_MAX_CONCURRENT_ANALYSES=1
