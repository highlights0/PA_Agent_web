# Multi-exchange market-data configuration
APP_ENV=development
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Binance Global Spot: official public market-data-only host
BINANCE_SPOT_REST_URL=https://data-api.binance.vision
# Binance USDⓈ-M Futures: may be region-restricted (HTTP 451 in some networks)
BINANCE_USDM_REST_URL=https://fapi.binance.com

# Alternative public Spot sources
BINANCE_US_SPOT_REST_URL=https://api.binance.us
COINBASE_SPOT_REST_URL=https://api.exchange.coinbase.com

# Gate.io public USDT perpetual futures (no API key for market-data endpoints)
GATE_FUTURES_REST_URL=https://api.gateio.ws/api/v4

BINANCE_HTTP_TIMEOUT=10
PUBLIC_MAX_BARS=300

# Optional legacy AI provider fallback. Prefer configuring providers in the Web UI.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_THINKING=true
AI_REASONING_EFFORT=medium

# Web AI settings security:
# In local APP_ENV=development, settings are allowed only from loopback requests.
# For a server deployment, set APP_ENV=production and a long random admin token.
AI_SETTINGS_ADMIN_TOKEN=
# Optional Fernet key. If blank, a local key file is generated in web/backend/data.
# Keep this key (or the generated ai_settings.key file) backed up; losing it makes saved API keys unrecoverable.
AI_SETTINGS_MASTER_KEY=
AI_PROVIDER_STORE_PATH=web/backend/data/ai_providers.json

# Public analysis is disabled until an operator configures an AI key.
PUBLIC_ANALYSIS_ENABLED=false
PUBLIC_ANALYSIS_PER_IP_DAILY=5
PUBLIC_MAX_CONCURRENT_ANALYSES=1
