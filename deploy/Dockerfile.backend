FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY pa_agent ./pa_agent
COPY prompt_engineering ./prompt_engineering
COPY web/backend/requirements.txt ./web/backend/requirements.txt

RUN python -m pip install --upgrade pip \
    && python -m pip install -e . --no-deps \
    && python -m pip install -r web/backend/requirements.txt

COPY web/backend/app ./web/backend/app

ENV PYTHONPATH=/app/web/backend

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--app-dir", "/app/web/backend", "--host", "0.0.0.0", "--port", "8000"]
